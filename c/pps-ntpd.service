[Unit]
Description=pps-ntpd - stratum-1 NTP server disciplined by GPS PPS
Documentation=https://github.com/ahmedsayidrashid/ntp-from-scratch
After=network.target dev-pps0.device dev-ttyAMA0.device
Wants=dev-pps0.device

[Service]
ExecStart=/usr/local/bin/pps-ntpd -d /dev/pps0 -s /dev/ttyAMA0 -b 9600 -p 123 -S 60
Restart=always
RestartSec=3
Nice=-10

# Unprivileged: a throwaway user in 'dialout' (60-pps.rules gives that group /dev/pps0)
# with only the right to bind UDP 123. The system clock is never touched.
DynamicUser=yes
SupplementaryGroups=dialout
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
